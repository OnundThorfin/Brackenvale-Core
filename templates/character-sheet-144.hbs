<form class="brackenvale-art-sheet {{cssClass}}" autocomplete="off">
  <nav class="brackenvale-page-tabs" aria-label="Character sheet pages">
    <div class="brackenvale-page-buttons">
      {{#each pages}}
        <button
          type="button"
          class="{{#if active}}active{{/if}}"
          data-page="{{page}}"
        >
          {{page}}
        </button>
      {{/each}}
    </div>

    {{#if isGM}}
      <div class="brackenvale-layout-tools">
        <button type="button" data-action="toggle-calibration">
          Calibrate
        </button>
        <button type="button" data-action="export-layout">
          Export Page JSON
        </button>
        <span class="brackenvale-calibration-status" aria-live="polite">
          No field selected
        </span>
      </div>
    {{/if}}
  </nav>

  {{#each pages}}
    <div
      class="brackenvale-art-page {{#if active}}active{{/if}}"
      data-page="{{page}}"
    >
      <img
        class="brackenvale-page-art"
        src="{{art}}"
        alt=""
        draggable="false"
      >

      <div class="brackenvale-page-fields">
        {{#each components}}
       {{#if isCantripList}}
  <section
    class="overlay-field page4-cantrip-list"
    style="{{style}}"
    data-component-key="{{key}}"
    data-layout-part="root"
    aria-label="{{label}}"
  >
    {{#each rows}}
      <div class="page4-spell-row">
        <button
          type="button"
          class="page4-cantrip-row"
          data-action="open-spell"
          data-item-id="{{id}}"
          title="Open {{name}}"
        >
          {{name}}
        </button>

        <button
          type="button"
          class="page4-spell-delete"
          data-action="delete-spell"
          data-item-id="{{id}}"
          title="Remove {{name}}"
          aria-label="Remove {{name}}"
        >
          ×
        </button>
      </div>
    {{/each}}
  </section>
{{/if}}
{{#if isPreparedSpellList}}
  <section
    class="overlay-field page4-prepared-spell-list"
    style="{{style}}"
    data-component-key="{{key}}"
    data-layout-part="root"
    aria-label="{{label}}"
  >
    <div class="page4-prepared-grid">
      {{#each rows}}
        <div class="page4-prepared-spell-row">
          <button
            type="button"
            class="page4-prepared-name"
            data-action="open-spell"
            data-item-id="{{id}}"
            title="Open {{name}}"
          >
            {{name}}
          </button>

          <div class="page4-prepared-casting">
            {{castingTime}}
          </div>

          <div class="page4-prepared-range">
            {{range}}
          </div>

          <div class="page4-prepared-component">
            {{#if concentration}}●{{/if}}
          </div>

          <div class="page4-prepared-component">
            {{#if ritual}}●{{/if}}
          </div>

          <div class="page4-prepared-component">
            {{#if material}}●{{/if}}
          </div>

          <button
            type="button"
            class="page4-spell-delete"
            data-action="delete-spell"
            data-item-id="{{id}}"
            title="Remove {{name}}"
            aria-label="Remove {{name}}"
          >
            ×
          </button>
        </div>
      {{/each}}
    </div>
  </section>
{{/if}}
{{#if isCulturalFeature}}
  <div
    class="overlay-field line-field class-level-wrapper"
    style="{{style}}"
    data-component-key="{{key}}"
    data-layout-part="root"
  >
    <span
      class="class-level-display"
      data-item-id="{{itemId}}"
    >{{value}}</span>

    <button
      type="button"
      class="class-level-overlay-button"
      data-action="cultural-feature"
      data-item-id="{{itemId}}"
      aria-label="{{label}}"
      title="{{#if itemId}}Open {{value}}{{else}}Choose a Cultural Feature{{/if}}"
      {{#unless editable}}disabled{{/unless}}
    ></button>

    {{#if itemId}}
      <button
        type="button"
        class="class-remove-button"
        data-action="remove-cultural-feature"
        data-item-id="{{itemId}}"
        aria-label="Remove {{value}}"
        title="Remove Cultural Feature"
        {{#unless editable}}disabled{{/unless}}
      >×</button>
    {{/if}}
  </div>
{{/if}}
          {{#if isTextField}}
            <input
              class="overlay-field {{className}}"
              type="{{inputType}}"
              name="{{name}}"
              value="{{value}}"
              style="{{style}}"
              aria-label="{{label}}"
              data-component-key="{{key}}"
              data-layout-part="root"
              {{#if readonly}}readonly{{/if}}
              {{#if disabled}}disabled{{/if}}
            >
          {{/if}}

          {{#if isSummaryControl}}
            <div
              class="overlay-field {{className}} class-level-wrapper"
              style="{{style}}"
              data-component-key="{{key}}"
              data-layout-part="root"
            >
              <span
                class="class-level-display"
                data-item-id="{{itemId}}"
              >{{value}}</span>

              <button
                type="button"
                class="class-level-overlay-button"
                data-action="{{summaryAction}}"
                data-origin-kind="{{summaryKind}}"
                data-item-id="{{itemId}}"
                aria-label="{{label}}"
                title="{{#if itemId}}Open {{value}}{{else}}{{value}}{{/if}}"
                {{#unless editable}}disabled{{/unless}}
              ></button>

              {{#if itemId}}
                <button
                  type="button"
                  class="class-remove-button"
                  data-action="{{removeAction}}"
                  data-origin-kind="{{summaryKind}}"
                  data-item-id="{{itemId}}"
                  aria-label="Remove {{value}}"
                  title="Remove {{label}}"
                  {{#unless editable}}disabled{{/unless}}
                >×</button>
              {{/if}}
            </div>
          {{/if}}

          {{#if isFeatureList}}
            <section
              class="overlay-field calibration-page2-field page2-list-panel page2-features-panel {{#if opaquePanel}}opaque-panel{{/if}}"
              style="{{style}}"
              data-component-key="{{key}}"
              data-layout-part="root"
              aria-label="{{label}}"
            >
              <div class="page2-list-content">
                {{#if hasClass}}
                  <div class="page2-class-actions">
                    {{#each classItems}}
                      <button type="button" class="page2-advance-class" data-action="advance-class" data-item-id="{{id}}" title="Advance {{name}} one level">Advance +1</button>
                      <button
                        type="button"
                        class="page2-manage-class"
                        data-action="manage-class"
                        data-item-id="{{id}}"
                        title="Open {{name}} to manage class advancement"
                      >
                        Manage {{name}}{{#if levels}} {{levels}}{{/if}}
                      </button>
                    {{/each}}
                  </div>
                {{/if}}

                <div class="page2-feature-rows">
                  {{#each rows}}
                    <button
                      type="button"
                      class="page2-feature-row"
                      data-action="open-feature"
                      data-item-id="{{id}}"
                      title="Open {{name}}"
                    >
                      <span class="page2-feature-name">{{name}}</span>
                      {{#if typeLabel}}
                        <span class="page2-feature-type">{{typeLabel}}</span>
                      {{/if}}
                    </button>
                  {{else}}
                    <div class="page2-empty-list">No features or traits have been granted yet.</div>
                  {{/each}}
                </div>
              </div>
            </section>
          {{/if}}

          {{#if isLanguageList}}
            <section
              class="overlay-field calibration-page2-field page2-list-panel page2-languages-panel {{#if opaquePanel}}opaque-panel{{/if}}"
              style="{{style}}"
              data-component-key="{{key}}"
              data-layout-part="root"
              aria-label="{{label}}"
            >
              <div class="page2-simple-rows">
                {{#each rows}}
                  <div class="page2-simple-row">{{this}}</div>
                {{else}}
                  <div class="page2-empty-list">No languages recorded.</div>
                {{/each}}
              </div>
            </section>
          {{/if}}

          {{#if isProficiencyList}}
            <section
              class="overlay-field calibration-page2-field page2-list-panel page2-proficiencies-panel {{#if opaquePanel}}opaque-panel{{/if}}"
              style="{{style}}"
              data-component-key="{{key}}"
              data-layout-part="root"
              aria-label="{{label}}"
            >
              <div class="page2-proficiency-groups">
                {{#each groups}}
                  <div class="page2-proficiency-group">
                    <strong>{{label}}</strong>
                    {{#each rows}}
                      <div class="page2-simple-row">{{this}}</div>
                    {{/each}}
                  </div>
                {{else}}
                  <div class="page2-empty-list">No proficiencies recorded.</div>
                {{/each}}
              </div>
            </section>
          {{/if}}

          {{#if isCheckboxField}}
            <input
              class="overlay-field {{className}}"
              type="checkbox"
              name="{{name}}"
              style="{{style}}"
              aria-label="{{label}}"
              data-component-key="{{key}}"
              data-layout-part="root"
              {{checked checked}}
              {{#if disabled}}disabled{{/if}}
            >
          {{/if}}

          {{#if isRollRow}}
            <div
              class="overlay-field {{className}} proficiency-rank-{{proficiencyRank}}"
              style="{{style}}"
              data-component-key="{{key}}"
              data-layout-part="root"
            >
              <button
                type="button"
                class="ability-roll-proficiency"
                aria-label="Change {{label}} proficiency"
                title="{{#if proficiencyEditable}}Click to cycle proficiency{{else}}Unlock the sheet to change proficiency{{/if}}"
                data-action="cycle-proficiency"
                data-path="{{proficiencyPath}}"
                data-rank="{{proficiencyRank}}"
                data-maximum-rank="{{maximumRank}}"
                {{#unless proficiencyEditable}}disabled{{/unless}}
              ></button>

              <button
                type="button"
                class="ability-roll-button"
                aria-label="{{label}}"
                title="Roll {{label}}"
                data-roll-type="{{rollType}}"
                data-roll-key="{{rollKey}}"
              >
                <span class="ability-roll-modifier">{{modifierValue}}</span>
              </button>
            </div>
          {{/if}}

          {{#if isHitDiceSummary}}
            <div
              class="overlay-field hit-dice-summary"
              style="{{style}}"
              data-component-key="{{key}}"
              data-layout-part="root"
              aria-label="{{label}}"
              data-supply-drop-zone="true"
              title="Drop an owned supply item here to track it"
            >
              <button
                type="button"
                class="hit-dice-denomination"
                data-action="edit-hit-dice-class"
                data-item-id="{{itemId}}"
                title="Open class and Hit Dice settings"
                {{#unless itemId}}disabled{{/unless}}
              >{{denomination}}</button>

              <button
                type="button"
                class="hit-dice-total"
                data-action="edit-hit-dice-class"
                data-item-id="{{itemId}}"
                title="Total Hit Dice comes from class level"
                {{#unless itemId}}disabled{{/unless}}
              >{{total}}</button>

              <input
                class="hit-dice-used"
                type="number"
                min="0"
                max="{{total}}"
                value="{{used}}"
                data-action="update-hit-dice-used"
                data-item-id="{{itemId}}"
                data-item-path="{{usedPath}}"
                aria-label="Used Hit Dice"
                title="Used Hit Dice"
                {{#unless editable}}disabled{{/unless}}
              >
            </div>
          {{/if}}

          {{#if isDeathSaveBubble}}
            <button
              type="button"
              class="overlay-field death-save-bubble {{#if filled}}filled{{/if}}"
              style="{{style}}"
              data-component-key="{{key}}"
              data-layout-part="root"
              data-action="set-death-save"
              data-path="{{path}}"
              data-value="{{value}}"
              aria-label="{{label}}"
              title="{{label}}"
              {{#unless editable}}disabled{{/unless}}
            ></button>
          {{/if}}

          {{#if isWeaponTable}}
            <div
              class="overlay-field weapon-toolbar"
              style="{{style}}"
              data-component-key="{{key}}"
              data-layout-part="root"
              aria-label="{{label}}"
            >
              {{#each weapons}}
                <div class="weapon-toolbar-row {{#unless id}}empty{{/unless}} {{#unless equipped}}unequipped{{/unless}}">
                  <button
                    type="button"
                    class="weapon-toolbar-cell weapon-name"
                    data-action="edit-weapon"
                    data-item-id="{{id}}"
                    title="{{#if id}}Open weapon item{{/if}}"
                    {{#unless id}}disabled{{/unless}}
                  >{{name}}</button>

                  <button
                    type="button"
                    class="weapon-toolbar-cell weapon-attack"
                    data-action="use-weapon"
                    data-item-id="{{id}}"
                    title="{{#if id}}Use weapon attack{{/if}}"
                    {{#unless id}}disabled{{/unless}}
                  >{{attack}}</button>

                  <button
                    type="button"
                    class="weapon-toolbar-cell weapon-damage"
                    data-action="roll-weapon-damage"
                    data-item-id="{{id}}"
                    title="{{#if id}}Use weapon damage workflow{{/if}}"
                    {{#unless id}}disabled{{/unless}}
                  >{{damage}}</button>

                  <button
                    type="button"
                    class="weapon-toolbar-cell weapon-mastery"
                    data-action="show-weapon-mastery"
                    data-item-id="{{id}}"
                    data-mastery-name="{{mastery}}"
                    data-mastery-reference="{{masteryReference}}"
                    title="{{#if masteryReference}}Open {{mastery}} rules{{else}}No mastery rules entry available{{/if}}"
                    {{#unless id}}disabled{{/unless}}
                  >{{mastery}}</button>
                </div>
              {{/each}}
            </div>
          {{/if}}

          {{#if isEquipmentRegion}}
            <div
              class="overlay-field equipment-region equipment-region-{{region}} {{#if slotOnly}}equipment-slot-only-region{{/if}} {{#if damageOnly}}equipment-damage-only-region{{/if}} {{#if opaquePanel}}equipment-opaque-panel{{/if}} {{#if itemRole}}equipment-role-{{itemRole}}{{/if}}"
              style="{{style}}"
              data-component-key="{{key}}"
              data-layout-part="root"
              {{#unless slotOnly}}{{#unless damageOnly}}data-equipment-drop-zone="{{region}}"{{/unless}}{{/unless}}
              aria-label="{{label}}"
              title="{{#if slotOnly}}Slot values{{else}}{{#if damageOnly}}Equipment damage{{else}}Drop items here{{/if}}{{/if}}"
            >
              {{#if slotOnly}}
                {{#each slotRows}}
                  <div class="equipment-slot-only-row" style="--slot-row: {{@index}};">{{slots}}</div>
                {{/each}}
              {{else}}
              {{#if damageOnly}}
                {{#each damageRows}}
                  <div class="equipment-damage-only-row {{#if broken}}broken{{/if}}" style="--damage-row: {{@index}};">
                    {{#each damageDots}}
                      <button
                        type="button"
                        class="equipment-damage-pip {{#if filled}}filled{{/if}}"
                        data-action="set-equipment-damage"
                        data-item-id="{{../id}}"
                        data-value="{{value}}"
                        aria-label="Set equipment damage to {{value}}"
                      ></button>
                    {{/each}}
                  </div>
                {{/each}}
              {{else}}
                {{#if armorItem}}
                  <div class="equipment-row equipment-defense-row equipment-armor-row">
                    <button
                      type="button"
                      class="equipment-item-name"
                      draggable="false"
                      data-equipment-item-id="{{armorItem.id}}"
                      data-item-id="{{armorItem.id}}"
                      title="Double-click to open item"
                    >{{armorItem.name}}</button>
                    {{#if editable}}
                      <button type="button" class="equipment-delete" data-action="delete-equipment-item" data-item-id="{{armorItem.id}}" title="Delete {{armorItem.name}}">×</button>
                    {{/if}}
                  </div>
                {{/if}}

                {{#if shieldItem}}
                  <div class="equipment-row equipment-defense-row equipment-shield-row">
                    <button
                      type="button"
                      class="equipment-item-name"
                      draggable="false"
                      data-equipment-item-id="{{shieldItem.id}}"
                      data-item-id="{{shieldItem.id}}"
                      title="Double-click to open item"
                    >{{shieldItem.name}}</button>
                    {{#if editable}}
                      <button type="button" class="equipment-delete" data-action="delete-equipment-item" data-item-id="{{shieldItem.id}}" title="Delete {{shieldItem.name}}">×</button>
                    {{/if}}
                  </div>
                {{/if}}

                {{#each items}}
                  <div class="equipment-row">
                    <button
                      type="button"
                      class="equipment-item-name"
                      draggable="false"
                      data-equipment-item-id="{{id}}"
                      data-item-id="{{id}}"
                      title="Double-click to open item"
                    >{{name}}</button>
                    {{#if ../editable}}
                      <button type="button" class="equipment-delete" data-action="delete-equipment-item" data-item-id="{{id}}" title="Delete {{name}}">×</button>
                    {{/if}}
                  </div>
                {{/each}}
                             {{#if editable}}
                  {{#if (eq region "packed-left")}}
                    <button
                      type="button"
                      class="equipment-add-item"
                      data-action="add-equipment-item"
                      title="Create a new item"
                    >
                      + Add Item
                    </button>
                  {{/if}}
                {{/if}}

              {{/if}}
              {{/if}}
            </div>
          {{/if}}

          {{#if isProvisionsWidget}}
  <section
    class="overlay-field provisions-widget"
    style="{{style}}"
    data-component-key="{{key}}"
    data-layout-part="root"
    aria-label="{{label}}"
  >
    <div class="provisions-row">
      <span class="provisions-label">Fresh Rations</span>
      <button
        type="button"
        class="provisions-button"
        data-action="adjust-provision"
        data-provision-key="fresh"
        data-delta="-1"
        {{#unless editable}}disabled{{/unless}}
      >−</button>
      <span class="provisions-value">{{fresh}}</span>
      <button
        type="button"
        class="provisions-button"
        data-action="adjust-provision"
        data-provision-key="fresh"
        data-delta="1"
        {{#unless editable}}disabled{{/unless}}
      >+</button>
    </div>

    <div class="provisions-row">
      <span class="provisions-label">Preserved Rations</span>
      <button
        type="button"
        class="provisions-button"
        data-action="adjust-provision"
        data-provision-key="preserved"
        data-delta="-1"
        {{#unless editable}}disabled{{/unless}}
      >−</button>
      <span class="provisions-value">{{preserved}}</span>
      <button
        type="button"
        class="provisions-button"
        data-action="adjust-provision"
        data-provision-key="preserved"
        data-delta="1"
        {{#unless editable}}disabled{{/unless}}
      >+</button>
    </div>

    <div class="provisions-row">
      <span class="provisions-label">Water</span>
      <button
        type="button"
        class="provisions-button"
        data-action="adjust-provision"
        data-provision-key="water"
        data-delta="-1"
        {{#unless editable}}disabled{{/unless}}
      >−</button>
      <span class="provisions-value">{{water}}</span>
      <button
        type="button"
        class="provisions-button"
        data-action="adjust-provision"
        data-provision-key="water"
        data-delta="1"
        {{#unless editable}}disabled{{/unless}}
      >+</button>
    </div>

    <div class="provisions-slots">
      Food {{rationSlots}} | Water {{waterSlots}} | Total {{provisionSlots}}
    </div>
  </section>
{{/if}}
          {{#if isSupplyWidget}}
            <div
              class="overlay-field supply-widget"
              style="{{style}}"
              data-component-key="{{key}}"
              data-layout-part="root"
              aria-label="{{label}}"
              data-supply-drop-zone="true"
              title="Drop an owned supply item here to track it"
            >
              {{#each rows}}
                <div class="supply-widget-row {{#if linked}}linked-supply{{/if}}" data-supply-index="{{index}}" data-linked-item-id="{{itemId}}">
                  <button
                    type="button"
                    class="supply-roll-name"
                    data-action="roll-supply-die"
                    data-supply-index="{{index}}"
                    title="Roll this Supply Die"
                    {{#unless ../editable}}disabled{{/unless}}
                  >{{#if name}}{{name}}{{else}}Supply{{/if}}</button>
                  <input
                    type="text"
                    class="supply-name-input"
                    value="{{name}}"
                    data-action="edit-supply-name"
                    data-supply-index="{{index}}"
                    aria-label="Supply name"
                    placeholder="Supply"
                    {{#if linked}}readonly title="Linked to an owned item"{{/if}}
                    {{#unless ../editable}}disabled{{/unless}}
                  >
                  <select
                    class="supply-die-select"
                    data-action="set-supply-die"
                    data-supply-index="{{index}}"
                    aria-label="{{#if name}}{{name}}{{else}}Supply{{/if}} die"
                    {{#unless ../editable}}disabled{{/unless}}
                  >
                    {{#each options}}
                      <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                    {{/each}}
                  </select>
                  {{#if name}}
                    <button
                      type="button"
                      class="supply-delete"
                      data-action="delete-supply"
                      data-supply-index="{{index}}"
                      aria-label="Delete {{name}}"
                      title="Delete {{name}} from Supplies and inventory"
                      {{#unless ../editable}}disabled{{/unless}}
                    >×</button>
                  {{/if}}
                </div>
              {{/each}}
            </div>
          {{/if}}

          {{#if isFlagTextArea}}
            <textarea
              class="overlay-field flag-text-area {{className}}"
              style="{{style}}"
              data-component-key="{{key}}"
              data-layout-part="root"
              data-flag-name="{{flag}}"
              aria-label="{{label}}"
              {{#unless editable}}disabled{{/unless}}
            >{{value}}</textarea>
          {{/if}}

          {{#if isEquippedDefenseName}}
            <button
              type="button"
              class="overlay-field equipped-defense-name"
              style="{{style}}"
              data-component-key="{{key}}"
              data-layout-part="root"
              data-item-id="{{itemId}}"
              aria-label="{{label}}"
              title="{{#if itemId}}Double-click to open item{{/if}}"
              {{#unless itemId}}disabled{{/unless}}
            >{{value}}</button>
          {{/if}}

          {{#if isAbilityScore}}
            <input
              class="overlay-field ability-score-field"
              type="number"
              name="{{scoreName}}"
              value="{{scoreValue}}"
              style="{{scoreStyle}}"
              aria-label="{{label}} score"
              data-component-key="{{key}}"
              data-layout-part="score"
              {{#if scoreDisabled}}disabled{{/if}}
            >

            <input
              class="overlay-field ability-modifier-field"
              type="text"
              value="{{modifierValue}}"
              style="{{modifierStyle}}"
              aria-label="{{label}} modifier"
              data-component-key="{{key}}"
              data-layout-part="modifier"
              readonly
              disabled
            >
          {{/if}}
        {{/each}}
      </div>

</div>
  {{/each}}
</form>
